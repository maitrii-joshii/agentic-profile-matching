# ============================================================
# Agentic Profile Matching — Environment Configuration Example
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.

# ----------------------------------------------------------
# API Keys
# ----------------------------------------------------------
# GROQ_API_KEY="your-groq-api-key-here"  (Decommissioned)
DEEPSEEK_API_KEY="your-deepseek-api-key-here"

# ----------------------------------------------------------
# ChromaDB
# ----------------------------------------------------------
# Directory where ChromaDB will persist its data on disk.
# Relative paths are resolved from the project root.
CHROMA_PERSIST_DIR=./chroma_store

# ----------------------------------------------------------
# Resume corpus
# ----------------------------------------------------------
# Directory containing the candidate resume files (PDF, JSON, TXT).
RESUME_DIR=./data/resumes

# ----------------------------------------------------------
# Embedding model
# ----------------------------------------------------------
# HuggingFace model ID for BAAI BGE embeddings.
# Default: BAAI/bge-small-en-v1.5 (fast, lightweight, high quality)
BGE_MODEL_NAME=BAAI/bge-small-en-v1.5
